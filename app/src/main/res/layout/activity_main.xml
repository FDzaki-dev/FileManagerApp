<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="@drawable/ic_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:scrollbars="none">
        <TextView
            android:id="@+id/breadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="/storage/emulated/0" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="@string/hint_search"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="text" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/pasteBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/accent"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pasteInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1B1B1B"
            android:textSize="13sp"
            android:text="2 item siap ditempel" />

        <TextView
            android:id="@+id/btnPasteHere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPEL DI SINI"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btnCancelPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATAL"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:elevation="4dp"
        android:visibility="gone"
        android:weightSum="5">

        <TextView
            android:id="@+id/btnRenameBatch"
            style="@style/ActionBarButton"
            android:text="@string/action_rename_batch" />

        <TextView
            android:id="@+id/btnCopy"
            style="@style/ActionBarButton"
            android:text="@string/action_copy" />

        <TextView
            android:id="@+id/btnMove"
            style="@style/ActionBarButton"
            android:text="@string/action_move" />

        <TextView
            android:id="@+id/btnZip"
            style="@style/ActionBarButton"
            android:text="@string/action_zip" />

        <TextView
            android:id="@+id/btnDelete"
            style="@style/ActionBarButton"
            android:text="@string/action_delete" />
    </LinearLayout>
</LinearLayout>
